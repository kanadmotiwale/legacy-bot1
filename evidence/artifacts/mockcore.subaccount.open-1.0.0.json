{
  "schema_version": "1.0",
  "capability_id": "mockcore.subaccount.open",
  "version": "1.0.0",
  "status": "approved",
  "title": "Open a sub-account",
  "description": "Opens a new sub-account for a member, funded from an existing account, and returns the confirmation reference.",
  "app": {
    "vendor_product": "MockCore Teller",
    "app_version_range": ">=4.0,<5.0",
    "surface": "legacy_web",
    "entry_point": "/app",
    "version_probe": {
      "frame_path": [
        {
          "name": "nav",
          "url_pattern": null
        }
      ],
      "pattern": "MockCore Teller (\\d+\\.\\d+\\.\\d+)"
    },
    "tenant_overrides": {}
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "5-digit member ID",
      "required": true,
      "constraints": {
        "pattern": "^\\d{5}$",
        "min_length": null,
        "max_length": null,
        "minimum": null,
        "maximum": null,
        "enum": null
      },
      "sensitivity": "pii",
      "example": null
    },
    {
      "name": "account_type",
      "type": "enum",
      "description": "Sub-account product",
      "required": true,
      "constraints": {
        "pattern": null,
        "min_length": null,
        "max_length": null,
        "minimum": null,
        "maximum": null,
        "enum": [
          "Sub-Savings",
          "Vacation Club",
          "Holiday Club"
        ]
      },
      "sensitivity": "public",
      "example": "Sub-Savings"
    },
    {
      "name": "nickname",
      "type": "string",
      "description": "Nickname; also the idempotency key",
      "required": true,
      "constraints": {
        "pattern": "^[A-Za-z0-9 ]{1,20}$",
        "min_length": null,
        "max_length": null,
        "minimum": null,
        "maximum": null,
        "enum": null
      },
      "sensitivity": "internal",
      "example": "Rainy Day"
    },
    {
      "name": "initial_deposit",
      "type": "decimal",
      "description": "Opening deposit in USD",
      "required": true,
      "constraints": null,
      "sensitivity": "internal",
      "example": "25.00"
    },
    {
      "name": "funding_account",
      "type": "string",
      "description": "Suffix of the funding account, e.g. S01",
      "required": true,
      "constraints": {
        "pattern": "^[A-Z]\\d{2}$",
        "min_length": null,
        "max_length": null,
        "minimum": null,
        "maximum": null,
        "enum": null
      },
      "sensitivity": "internal",
      "example": "S01"
    }
  ],
  "outputs": [
    {
      "name": "reference_number",
      "type": "string",
      "description": "Confirmation reference number of the new sub-account",
      "sensitivity": "internal",
      "normalize": "trim",
      "required": false
    }
  ],
  "outcomes": [
    {
      "name": "member_not_found",
      "description": "No member exists with the given member ID.",
      "detail_fields": []
    },
    {
      "name": "permission_denied",
      "description": "The service account may not view this member (e.g. restricted employee account).",
      "detail_fields": []
    },
    {
      "name": "validation_error",
      "description": "The application rejected the submitted values. field_errors maps field -> message.",
      "detail_fields": [
        "field_errors"
      ]
    }
  ],
