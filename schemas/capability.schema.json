{
  "$defs": {
    "AppBinding": {
      "additionalProperties": false,
      "properties": {
        "vendor_product": {
          "title": "Vendor Product",
          "type": "string"
        },
        "app_version_range": {
          "description": "e.g. '>=4.0,<5.0'",
          "title": "App Version Range",
          "type": "string"
        },
        "surface": {
          "enum": [
            "web",
            "legacy_web",
            "desktop"
          ],
          "title": "Surface",
          "type": "string"
        },
        "entry_point": {
          "description": "path relative to the tenant base URL",
          "title": "Entry Point",
          "type": "string"
        },
        "version_probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionProbe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tenant_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/TenantOverride"
          },
          "title": "Tenant Overrides",
          "type": "object"
        }
      },
      "required": [
        "vendor_product",
        "app_version_range",
        "surface",
        "entry_point"
      ],
      "title": "AppBinding",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "min_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Css": {
      "additionalProperties": false,
      "description": "Last resort. Structural path without generated class names.",
      "properties": {
        "strategy": {
          "const": "css",
          "default": "css",
          "title": "Strategy",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        }
      },
      "required": [
        "selector"
      ],
      "title": "Css",
      "type": "object"
    },
    "DetailExtraction": {
      "additionalProperties": false,
      "description": "Extract structured detail for a business outcome, e.g. per-field validation errors.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "anchor_text": {
          "description": "text heading a block of lines",
          "title": "Anchor Text",
          "type": "string"
        },
        "parse": {
          "default": "lines",
          "enum": [
            "lines",
            "field_colon_message"
          ],
          "title": "Parse",
          "type": "string"
        },
        "frame_path": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FrameRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Path"
        }
      },
      "required": [
        "name",
        "anchor_text"
      ],
      "title": "DetailExtraction",
      "type": "object"
    },
    "Dismiss": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "dismiss",
          "default": "dismiss",
          "title": "Type",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "max_times": {
          "default": 3,
          "title": "Max Times",
          "type": "integer"
        }
      },
      "required": [
        "target"
      ],
      "title": "Dismiss",
      "type": "object"
    },
    "ElementVisible": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "element_visible",
          "default": "element_visible",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "target"
      ],
      "title": "ElementVisible",
      "type": "object"
    },
    "Escalate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "escalate",
          "default": "escalate",
          "title": "Type",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Escalate",
      "type": "object"
    },
    "Fail": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fail",
          "default": "fail",
          "title": "Type",
          "type": "string"
        },
        "error_code": {
          "title": "Error Code",
          "type": "string"
        }
      },
      "required": [
        "error_code"
      ],
      "title": "Fail",
      "type": "object"
    },
    "FieldValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "field_value",
          "default": "field_value",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "equals": {
          "title": "Equals",
          "type": "string"
        }
      },
      "required": [
        "target",
        "equals"
      ],
      "title": "FieldValue",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "url_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url Pattern"
        }
      },
      "title": "FrameRef",
      "type": "object"
    },
    "Handler": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "detect": {
          "description": "all must hold",
          "items": {
            "discriminator": {
              "mapping": {
                "element_visible": "#/$defs/ElementVisible",
                "field_value": "#/$defs/FieldValue",
                "http_status": "#/$defs/HttpStatus",
                "route_matches": "#/$defs/RouteMatches",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RouteMatches"
              },
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementVisible"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/HttpStatus"
              }
            ]
          },
          "minItems": 1,
          "title": "Detect",
          "type": "array"
        },
        "category": {
          "enum": [
            "business_outcome",
            "recoverable",
            "hard_failure"
          ],
          "title": "Category",
          "type": "string"
        },
        "applies_to": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "const": "*",
              "type": "string"
            }
          ],
          "default": "*",
          "title": "Applies To"
        },
        "response": {
          "discriminator": {
            "mapping": {
              "dismiss": "#/$defs/Dismiss",
              "escalate": "#/$defs/Escalate",
              "fail": "#/$defs/Fail",
              "reauthenticate": "#/$defs/Reauthenticate",
              "retry": "#/$defs/Retry",
              "return_outcome": "#/$defs/ReturnOutcome"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReturnOutcome"
            },
            {
              "$ref": "#/$defs/Dismiss"
            },
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "$ref": "#/$defs/Reauthenticate"
            },
            {
              "$ref": "#/$defs/Escalate"
            },
            {
              "$ref": "#/$defs/Fail"
            }
          ],
          "title": "Response"
        }
      },
      "required": [
        "id",
        "description",
        "detect",
        "category",
        "response"
      ],
      "title": "Handler",
      "type": "object"
    },
    "HttpStatus": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "http_status",
          "default": "http_status",
          "title": "Kind",
          "type": "string"
        },
        "min": {
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "title": "Max",
          "type": "integer"
        },
        "frame_path": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FrameRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Path"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "HttpStatus",
      "type": "object"
    },
    "Idempotency": {
      "additionalProperties": false,
      "properties": {
        "key_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Key Inputs",
          "type": "array"
        },
        "probe_steps": {
          "description": "read-only steps that reveal whether the effect already exists",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Probe Steps",
          "type": "array"
        },
        "exists": {
          "items": {
            "discriminator": {
              "mapping": {
                "element_visible": "#/$defs/ElementVisible",
                "field_value": "#/$defs/FieldValue",
                "http_status": "#/$defs/HttpStatus",
                "route_matches": "#/$defs/RouteMatches",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RouteMatches"
              },
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementVisible"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/HttpStatus"
              }
            ]
          },
          "title": "Exists",
          "type": "array"
        },
        "on_exists_extract": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "On Exists Extract",
          "type": "array"
        }
      },
      "required": [
        "key_inputs",
        "probe_steps",
        "exists"
      ],
      "title": "Idempotency",
      "type": "object"
    },
    "InputParam": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "decimal",
            "date",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Constraints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "synthetic example; never a discovery value for PII",
          "title": "Example"
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "sensitivity"
      ],
      "title": "InputParam",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "description": "Control programmatically associated with a label (<label for>, aria-label).",
      "properties": {
        "strategy": {
          "const": "label",
          "default": "label",
          "title": "Strategy",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Label",
      "type": "object"
    },
    "NearLabel": {
      "additionalProperties": false,
      "description": "Legacy forms: the control (or, with no control_role, the value cell) in the table\ncell right after the cell whose text is `label_text`.",
      "properties": {
        "strategy": {
          "const": "near_label",
          "default": "near_label",
          "title": "Strategy",
          "type": "string"
        },
        "label_text": {
          "title": "Label Text",
          "type": "string"
        },
        "control_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Role"
        }
      },
      "required": [
        "label_text"
      ],
      "title": "NearLabel",
      "type": "object"
    },
    "OutcomeSpec": {
      "additionalProperties": false,
      "description": "A business outcome the caller must handle - part of the signature, like a checked exception.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "detail_fields": {
          "items": {
            "type": "string"
          },
          "title": "Detail Fields",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "OutcomeSpec",
      "type": "object"
    },
    "OutputField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "decimal",
            "integer",
            "date",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "normalize": {
          "default": "trim",
          "enum": [
            "none",
            "trim",
            "currency_to_decimal",
            "mdy_to_iso_date"
          ],
          "title": "Normalize",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "description",
        "sensitivity"
      ],
      "title": "OutputField",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "discovery_run_id": {
          "title": "Discovery Run Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "recorder_version": {
          "title": "Recorder Version",
          "type": "string"
        },
        "goal_redacted": {
          "title": "Goal Redacted",
          "type": "string"
        },
        "redactions_applied": {
          "items": {
            "type": "string"
          },
          "title": "Redactions Applied",
          "type": "array"
        },
        "human_steps": {
          "description": "step ids performed by an operator; need review",
          "items": {
            "type": "string"
          },
          "title": "Human Steps",
          "type": "array"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "parent_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Version"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "discovery_run_id",
        "model",
        "recorded_at",
        "recorder_version",
        "goal_redacted"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Reauthenticate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reauthenticate",
          "default": "reauthenticate",
          "title": "Type",
          "type": "string"
        },
        "max_times": {
          "default": 1,
          "title": "Max Times",
          "type": "integer"
        }
      },
      "title": "Reauthenticate",
      "type": "object"
    },
    "Retry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "retry",
          "default": "retry",
          "title": "Type",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/RetryPolicy"
        }
      },
      "title": "Retry",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "backoff_ms": {
          "items": {
            "type": "integer"
          },
          "title": "Backoff Ms",
          "type": "array"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "ReturnOutcome": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "return_outcome",
          "default": "return_outcome",
          "title": "Type",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/DetailExtraction"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "ReturnOutcome",
      "type": "object"
    },
    "RiskClass": {
      "enum": [
        "safe",
        "reversible",
        "irreversible"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "RoleName": {
      "additionalProperties": false,
      "description": "Accessibility role + accessible name. Maps 1:1 onto UIA ControlType+Name / AX role+title.",
      "properties": {
        "strategy": {
          "const": "role_name",
          "default": "role_name",
          "title": "Strategy",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "RoleName",
      "type": "object"
    },
    "RouteMatches": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "route_matches",
          "default": "route_matches",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "frame_path": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FrameRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Path"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "RouteMatches",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        "public",
        "internal",
        "pii",
        "secret"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SessionSpec": {
      "additionalProperties": false,
      "properties": {
        "login_route": {
          "title": "Login Route",
          "type": "string"
        },
        "login_steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Login Steps",
          "type": "array"
        },
        "logged_in": {
          "items": {
            "discriminator": {
              "mapping": {
                "element_visible": "#/$defs/ElementVisible",
                "field_value": "#/$defs/FieldValue",
                "http_status": "#/$defs/HttpStatus",
                "route_matches": "#/$defs/RouteMatches",
                "text_visible": "#/$defs/TextVisible"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RouteMatches"
              },
              {
                "$ref": "#/$defs/TextVisible"
              },
              {
                "$ref": "#/$defs/ElementVisible"
              },
              {
                "$ref": "#/$defs/FieldValue"
              },
              {
                "$ref": "#/$defs/HttpStatus"
              }
            ]
          },
          "title": "Logged In",
          "type": "array"
        },
        "credential_refs": {
          "items": {
            "type": "string"
          },
          "title": "Credential Refs",
          "type": "array"
        }
      },
      "required": [
        "login_route",
        "login_steps",
        "logged_in",
